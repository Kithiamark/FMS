# Database
POSTGRES_DB=fms_prod
POSTGRES_USER=fms_user
POSTGRES_PASSWORD=secure_password_here
DATABASE_URL=postgres://fms_user:secure_password_here@db:5432/fms_prod

# Django Security
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=generate_a_secure_random_key_here
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
SECURE_SSL_REDIRECT=False

# Field Encryption
# Generate FIELD_ENCRYPTION_KEY: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=generate_a_unique_32_byte_base64_fernet_key_here

# Media Serving (set to True when running in standalone containers without an Nginx reverse proxy)
SERVE_MEDIA=False

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# External APIs
MPESA_CONSUMER_KEY=your_key
MPESA_CONSUMER_SECRET=your_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/finance/mpesa/callback
MPESA_ENV=sandbox

AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_at_api_key

AI_SERVICE_API_KEY=dev-secret-key
