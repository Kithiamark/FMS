meta {
  name: "Refresh Access Token"
  type: "http"
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/token/refresh/
  body: json
  auth: none
}

body:json {
  {
    "refresh": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body.access) {
    bru.setEnvVar("token", res.body.access);
  }
}
